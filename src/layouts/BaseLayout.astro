---
// Self-hosted fonts: no request to Google, and one variable file per family.
// The browser only downloads the subsets the page uses (Latin for EN and FR).
import "@fontsource-variable/space-grotesk/wght.css";
import "@fontsource-variable/source-sans-3/wght.css";
import "@fontsource/ibm-plex-mono/400.css";
// The heading and body fonts are preloaded, so they arrive with the page and
// the text does not jump when they replace the fallback font (layout shift).
import spaceGroteskFont from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import sourceSansFont from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import "../styles/global.css";
import { siteConfig } from "../content/site-config";
import { getContent } from "../content/site-content";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title: string;
  description: string;
  lang: "en" | "fr";
}

const { title, description, lang } = Astro.props;
const { header, meta } = getContent(lang);
const alternateLang = lang === "en" ? "fr" : "en";
const canonicalUrl = new URL(Astro.url.pathname, siteConfig.siteUrl);
const alternateUrl = new URL(`/${alternateLang}/`, siteConfig.siteUrl);

// 1200 x 630 sharing image, one per language (public/og/)
const ogImage = new URL(`/og/og-${lang}.png`, siteConfig.siteUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Light or dark theme: the visitor's choice if they made one with the
      button in the header, otherwise their system setting. It runs before
      the page is drawn, so the page never flashes the wrong colours.
    -->
    <script is:inline>
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch (error) {
          // Storage blocked by the browser settings: use the system setting
        }
        if (theme !== "light" && theme !== "dark") {
          theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <link rel="preload" href={spaceGroteskFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sourceSansFont} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Site icon. The ICO and PNG are for search engines and browsers that
         do not use the SVG (DuckDuckGo reads favicon.ico). Phones use the
         Apple touch icon when the site is saved to the home screen. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Canonical and hreflang -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />
    <link rel="alternate" hreflang={lang} href={canonicalUrl} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL("/en/", siteConfig.siteUrl)}
    />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Hard Skills Lab" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_FR"} />
    <meta
      property="og:locale:alternate"
      content={lang === "en" ? "fr_FR" : "en_US"}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data for search engines and AI tools -->
    <StructuredData lang={lang} pageUrl={canonicalUrl} title={title} description={description} />

    <title>{title}</title>
  </head>
  <body>
    <!-- Skip link: first thing a keyboard user reaches. Pages need <main id="main">. -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-60 focus:bg-ink focus:px-4 focus:py-3 focus:text-sm focus:font-semibold focus:text-paper"
    >
      {header.skipLink}
    </a>
    <slot />
  </body>
</html>
