---
import { Image } from "astro:assets";
import PrimaryButton from "@/components/PrimaryButton.astro";
import { getContent, getMainCta } from "@/content/site-content";
// Stock photos for now, credits in src/assets/photos/CREDITS.md
import abstractPhoto from "@/assets/photos/abstractPhoto.jpg";
import heroPhoto from "@/assets/photos/hero-laptop.jpg";

interface Props {
  lang: Parameters<typeof getContent>[0];
}

const { lang } = Astro.props;
const t = getContent(lang);
const cta = getMainCta(lang);
---

<!--
  Hero. A <div> on purpose (not a <section>): the temporary global
  `section { padding }` rule would override its spacing. Revisit in 1.4.h.
-->
<div id="top" class="relative scroll-mt-20 overflow-hidden">
  <!-- Text -->
  <div class="container-page">
    <div
      class="relative z-10 flex flex-col justify-center pb-10 pt-10 sm:pt-14 lg:min-h-136 lg:w-[55%] lg:py-20"
    >
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1
        class="mt-5 font-heading text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl xl:text-6xl"
      >
        {t.hero.titleLines.map((line) => <span class="block">{line}</span>)}
      </h1>
      <p class="mt-6 max-w-md text-base text-ink/80 sm:text-lg">
        {t.hero.subtitle}
      </p>

      <!-- Key facts, so visitors get the essentials at a glance -->
      <ul
        class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold text-ink sm:text-base"
      >
        {
          t.hero.facts.map((fact) => (
            <li class="flex items-center gap-2">
              <span class="size-1.5 shrink-0 bg-orange" aria-hidden="true" />
              {fact}
            </li>
          ))
        }
      </ul>

      <!-- data-hero-actions: the mobile sticky button stays hidden while these are on screen -->
      <div class="mt-8 flex flex-wrap gap-3" data-hero-actions>
        <PrimaryButton href={cta.href} srLabel={cta.newTab} arrow>
          {cta.label}
        </PrimaryButton>
        <PrimaryButton href="#curriculum" variant="secondary">
          {t.cta.curriculum}
        </PrimaryButton>
      </div>
    </div>
  </div>

  <!-- Visual: below the text on mobile, anchored to the right on desktop -->
  <div
    class="px-4 pb-8 sm:px-6 lg:absolute lg:inset-y-0 lg:right-0 lg:w-[50%] lg:p-0 2xl:w-[45%]"
  >
    <!-- 16:9 on phones (was 4:5) so the page gets to the program faster -->
    <div class="relative aspect-video sm:aspect-16/10 lg:aspect-auto lg:h-full">
      <div class="absolute inset-0 overflow-hidden bg-rule lg:right-[9%]">
        <!--
          Above the fold, so it loads first. On desktop the box is almost square,
          so the photo is cropped on the sides: about 70vw of image for a 50vw box.
          object-position keeps her in frame.
        -->
        <Image
          src={heroPhoto}
          alt={t.hero.photoAlt}
          widths={[640, 960, 1280, 1600, 2000]}
          sizes="(min-width: 1024px) 70vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-[65%_50%]"
        />
      </div>

      <!-- Orange block (desktop only) -->
      <div
        class="absolute right-0 top-[37%] hidden h-[15.5%] w-[9%] bg-orange lg:block"
        aria-hidden="true"
      >
      </div>

      <!-- Small photo (desktop only, decorative). Lazy, so phones never download it. -->
      <div
        class="absolute bottom-0 right-0 hidden h-[47%] w-[20%] overflow-hidden bg-ink lg:block"
      >
        <Image
          src={abstractPhoto}
          alt=""
          widths={[240, 480]}
          sizes="15vw"
          class="h-full w-full object-cover object-[35%_50%]"
        />
      </div>

      <!-- Learn / Build / Grow (desktop only, decorative) -->
      <ul
        class="absolute right-[calc(9%+2rem)] top-[17%] hidden border-l-2 border-orange pl-3 text-xs font-medium uppercase leading-5 tracking-[0.18em] text-ink lg:block"
        aria-hidden="true"
      >
        {t.hero.pillars.map((pillar) => <li>{pillar}</li>)}
      </ul>
    </div>
  </div>

  <!-- Scroll cue (mobile / tablet) -->
  <div class="container-page pb-6 lg:hidden">
    <a
      href="#program"
      class="inline-flex min-h-11 flex-col items-start justify-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"
    >
      {t.hero.scroll}
      <svg
        class="size-4"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M12 5v14M6 13l6 6 6-6"></path>
      </svg>
    </a>
  </div>
</div>
