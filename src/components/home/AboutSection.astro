---
import ImagePlaceholder from "@/components/ImagePlaceholder.astro";
import type { Language } from "@/content/site-config";
import { getContent } from "@/content/site-content";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { about } = getContent(lang);
---

<section id="about" class="section-y bg-paper-soft lg:bg-paper">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Intro -->
      <div class="lg:col-span-5">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 class="heading-section mt-4 max-w-md">{about.title}</h2>
        <p class="mt-5 max-w-md text-base text-muted sm:text-lg">
          {about.intro}
        </p>
      </div>

      <!-- Team -->
      <div class="lg:col-span-7">
        <ul class="space-y-8">
          {
            about.team.map((member) => (
              <li class="flex gap-5 sm:gap-6">
                <div class="relative aspect-4/5 w-28 shrink-0 sm:w-36">
                  <ImagePlaceholder
                    label={member.photoLabel}
                    class="absolute inset-0"
                  />
                </div>
                <div class="min-w-0">
                  <h3 class="font-heading text-lg font-semibold leading-snug">
                    {member.name}
                  </h3>
                  <p class="mt-1 text-xs text-muted sm:text-sm">
                    {member.role}
                  </p>
                  <p class="mt-3 max-w-md text-sm text-ink/80">{member.bio}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <!-- <div class="mt-10 bg-rule/40 p-6 sm:p-8">
          <Icon name="users" class="size-8 text-orange" />
          <h3 class="mt-4 font-heading text-lg font-semibold">
            {about.together.title}
          </h3>
          <p class="mt-2 max-w-md text-sm text-muted">{about.together.text}</p>
        </div> -->
      </div>
    </div>
  </div>
</section>
