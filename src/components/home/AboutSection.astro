---
import Icon from "@/components/Icon.astro";
import type { Language } from "@/content/site-config";
import { getContent } from "@/content/site-content";

interface Props {
  lang: Language;
}

const { lang } = Astro.props;
const { about } = getContent(lang);
---

<!--
  About: the mission and why it matters. No team cards on purpose,
  the track leads are named in the curriculum instead.
-->
<section id="about" class="section-y bg-paper lg:bg-paper-soft">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Intro -->
      <div class="lg:col-span-5">
        <p class="eyebrow">{about.eyebrow}</p>
        <h2 class="heading-section mt-4 max-w-md">{about.title}</h2>
        <p class="mt-5 max-w-md text-base text-muted sm:text-lg">
          {about.intro}
        </p>
      </div>

      <!-- Why it matters -->
      <ul class="border-t border-rule lg:col-span-7">
        {
          about.points.map((point) => (
            <li class="flex gap-5 border-b border-rule py-6 sm:gap-6">
              <Icon name={point.icon} class="size-8 text-orange" />
              <div class="min-w-0">
                <h3 class="font-heading text-lg font-semibold leading-snug">
                  {point.title}
                </h3>
                <p class="mt-2 max-w-lg text-sm text-ink/80 sm:text-base">
                  {point.text}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
