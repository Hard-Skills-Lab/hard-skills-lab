---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { getContent } from "@/content/site-content";
// Stock photo for now, credits in src/assets/photos/CREDITS.md
import classPhoto from "@/assets/photos/coding-class.jpg";

interface Props {
  lang: Parameters<typeof getContent>[0];
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<!-- Program Section (includes the mission card) -->
<section id="program" class="section-y bg-paper-soft">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-stretch lg:gap-12">
      <!-- Intro + facts -->
      <div class="lg:col-span-7">
        <p class="eyebrow">{t.program.eyebrow}</p>
        <h2 class="heading-section mt-4 max-w-xl">{t.program.title}</h2>
        <p class="mt-5 max-w-xl text-base text-muted sm:text-lg">
          {t.program.intro}
        </p>

        <ul
          class="mt-10 grid grid-cols-2 border-y border-rule md:grid-cols-4 md:border-y-0"
        >
          {
            t.program.facts.map((fact) => (
              <li class="border-rule px-4 py-6 odd:pl-0 even:border-l nth-[n+3]:border-t md:first:pl-0 md:nth-[n+2]:border-l md:nth-[n+2]:pl-4 md:nth-[n+3]:border-t-0">
                <Icon name={fact.icon} class="size-8 text-orange" />
                <p class="mt-4 font-heading text-base font-semibold leading-snug">
                  {fact.title}
                </p>
                <p class="mt-1 text-sm text-muted">{fact.text}</p>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Mission card (desktop only) -->
      <div class="hidden lg:col-span-5 lg:block">
        <div class="grid h-full grid-cols-2 bg-rule/40">
          <div class="flex flex-col p-8">
            <p class="eyebrow">{t.program.mission.eyebrow}</p>
            <h3
              class="mt-4 font-heading text-xl font-semibold leading-tight xl:text-2xl"
            >
              {t.program.mission.title}
            </h3>
            <p class="mt-4 text-sm text-muted">{t.program.mission.text}</p>
            <div class="mt-auto pt-8">
              <span class="block h-0.5 w-8 bg-orange" aria-hidden="true"></span>
            </div>
          </div>
          <div class="relative min-h-80 overflow-hidden bg-ink">
            <Image
              src={classPhoto}
              alt={t.program.photoAlt}
              widths={[320, 480, 640]}
              sizes="20vw"
              class="absolute inset-0 h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Landscape + Learn › Build › Grow (mobile / tablet) -->
    <div
      class="relative mt-10 aspect-16/10 overflow-hidden bg-ink sm:aspect-2/1 lg:hidden"
    >
      <Image
        src={classPhoto}
        alt={t.program.photoAlt}
        widths={[480, 800, 1000]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover object-[50%_30%]"
      />
      <!-- Dark fade at the bottom so the white text stays readable -->
      <div
        class="absolute inset-0 bg-linear-to-t from-ink/80 via-ink/10 to-transparent"
        aria-hidden="true"
      >
      </div>
      <p
        class="absolute bottom-3 left-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-white"
        aria-hidden="true"
      >
        {t.hero.pillars.join("  ›  ")}
      </p>
    </div>
  </div>
</section>
