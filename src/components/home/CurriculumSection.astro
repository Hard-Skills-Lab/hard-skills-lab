---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import TrackLead from "@/components/TrackLead.astro";
import { getContent } from "@/content/site-content";
// Stock photo for now, credits in src/assets/photos/CREDITS.md
import developerPhoto from "@/assets/photos/developer-code.jpg";

interface Props {
  lang: Parameters<typeof getContent>[0];
}

const { lang } = Astro.props;
const t = getContent(lang);
---

<!-- Curriculum Section -->
<section id="curriculum" class="section-y bg-paper-soft">
  <div class="container-page">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Intro -->
      <div class="lg:col-span-4 xl:col-span-5">
        <p class="eyebrow">{t.curriculum.eyebrow}</p>
        <h2 class="heading-section mt-4 max-w-md">
          {
            t.curriculum.title.map((line) => (
              <span class="inline-block pr-2 md:block">{line}</span>
            ))
          }
        </h2>
        <p class="mt-5 max-w-md text-base text-muted sm:text-lg">
          {t.curriculum.intro}
        </p>

        <!-- Tools -->
        <p class="mt-8 text-sm font-semibold">{t.curriculum.toolsTitle}</p>
        <ul class="mt-3 flex max-w-md flex-wrap gap-2">
          {
            t.curriculum.tools.map((tool) => (
              <li class="border border-rule bg-paper px-2.5 py-1 font-mono text-xs text-ink">
                {tool}
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Mobile / tablet: one list, data + AI topic per week.
           Assumes tracks[0] = data and tracks[1] = AI. -->
      <ol class="border-t border-rule lg:hidden">
        {
          t.curriculum.tracks[0].weeks.map((dataWeek, index) => (
            <li class="flex gap-4 border-b border-rule py-5">
              <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-orange-deep text-[11px] font-semibold text-white">
                {index + 1}
              </span>
              <div>
                <p class="text-xs text-muted">
                  {t.curriculum.weekLabel} {index + 1}
                </p>
                <p class="mt-1 text-sm font-medium">{dataWeek}</p>
                <p class="my-0.5 text-xs text-muted" aria-hidden="true">
                  +
                </p>
                <p class="text-sm text-muted">
                  {t.curriculum.tracks[1].weeks[index]}
                </p>
              </div>
            </li>
          ))
        }
      </ol>

      <!-- Desktop: one column per track -->
      <div
        class="hidden gap-8 lg:col-span-8 lg:grid lg:grid-cols-2 xl:col-span-7 xl:gap-12"
      >
        {
          t.curriculum.tracks.map((track) => (
            <div>
              <h3 class="flex flex-wrap items-baseline gap-x-2 font-heading text-lg font-semibold leading-snug">
                {track.shortTitle}
              </h3>
              <TrackLead
                label={t.curriculum.leadLabel}
                name={track.lead.name}
                role={track.lead.role}
                linkedin={track.lead.linkedin}
                linkLabel={t.curriculum.leadLink}
                class="mt-2"
              />
              <ol class="relative mt-4 before:absolute before:bottom-6 before:left-[11.5px] before:top-6 before:w-px before:bg-orange/40">
                {track.weeks.map((week, index) => (
                  <li class="relative flex items-center gap-3 border-b border-rule py-3 text-sm">
                    <span class="relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full bg-orange-deep text-[11px] font-semibold text-white">
                      {index + 1}
                    </span>
                    <span>{week}</span>
                  </li>
                ))}
              </ol>

              {/* What learners can do at the end of the track */}
              <p class="mt-6 text-sm font-semibold">
                {t.curriculum.outcomesTitle}
              </p>
              <ul class="mt-3 space-y-2">
                {track.outcomes.map((outcome) => (
                  <li class="flex gap-2 text-sm text-muted">
                    <Icon name="check" class="mt-0.5 size-4 text-orange" />
                    {outcome}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!--
  Tracks (mobile / tablet only: on desktop the tracks are the two columns
  above). No id on purpose: it is display:none on desktop and would
  confuse the header's scroll-spy.
-->
<section class="section-y bg-paper lg:hidden">
  <div class="container-page">
    <p class="eyebrow">{t.curriculum.tracksSection.eyebrow}</p>
    <h2 class="heading-section mt-4">{t.curriculum.tracksSection.title}</h2>
    <p class="mt-5 max-w-xl text-base text-muted sm:text-lg">
      {t.curriculum.tracksSection.intro}
    </p>

    <ol class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        t.curriculum.tracks.map((track, index) => (
          <li class="bg-rule/40 p-6">
            <span
              class="font-heading text-3xl font-normal text-orange"
              aria-hidden="true"
            >
              {String(index + 1).padStart(2, "0")}
            </span>
            <h3 class="mt-3 font-heading text-xl font-semibold leading-tight">
              {track.title}
            </h3>
            <TrackLead
              label={t.curriculum.leadLabel}
              name={track.lead.name}
              role={track.lead.role}
              linkedin={track.lead.linkedin}
              linkLabel={t.curriculum.leadLink}
              class="mt-3"
            />
            <p class="mt-4 text-sm text-muted">{track.summary}</p>

            <p class="mt-5 text-sm font-semibold">
              {t.curriculum.outcomesTitle}
            </p>
            <ul class="mt-2 space-y-2">
              {track.outcomes.map((outcome) => (
                <li class="flex gap-2 text-sm text-muted">
                  <Icon name="check" class="mt-0.5 size-4 text-orange" />
                  {outcome}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <div class="mt-6 aspect-video overflow-hidden bg-ink sm:aspect-2/1">
      <Image
        src={developerPhoto}
        alt={t.curriculum.tracksSection.photoAlt}
        widths={[480, 800, 1000]}
        sizes="100vw"
        class="h-full w-full object-cover"
      />
    </div>
  </div>
</section>
