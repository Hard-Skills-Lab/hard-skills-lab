---
import type { Language } from "../content/site-config";
import { siteConfig } from "../content/site-config";
import { getContent } from "../content/site-content";
import type { SiteContent } from "../content/site-content";
import { socialLinks } from "../content/social-links";
import SiteLogo from "./SiteLogo.astro";
import Icon from "./Icon.astro";
import LanguageSwitch from "./LanguageSwitch.astro";

interface Props {
  lang: Language;
  footer: SiteContent["footer"];
  navigation: SiteContent["navigation"];
}

const { lang, footer, navigation } = Astro.props;
const { header } = getContent(lang);
const year = new Date().getFullYear();

// Same links and order as the header
const navItems = [
  { label: navigation.home, href: "#top" },
  { label: navigation.program, href: "#program" },
  { label: navigation.curriculum, href: "#curriculum" },
  { label: navigation.projects, href: "#projects" },
  { label: navigation.about, href: "#about" },
  { label: navigation.faq, href: "#faq" },
];
---

<footer class="bg-ink text-white">
  <div class="container-page py-10 md:py-12">
    <!-- Row 1: logo + navigation -->
    <div
      class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between"
    >
      <SiteLogo lang={lang} inverted />

      <nav aria-label={footer.navigation}>
        <ul class="-mx-3 flex flex-wrap">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-11 items-center px-3 text-sm text-white/80 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Row 2: copyright + contact -->
    <div
      class="mt-8 flex flex-col gap-3 border-t border-white/10 pt-6 md:flex-row md:items-center md:justify-between"
    >
      <p class="text-sm text-white/50">
        © {year} Hard Skills Lab. {footer.rights}
      </p>

      <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="inline-flex min-h-11 items-center text-sm text-white/80 transition-colors hover:text-white"
        >
          {siteConfig.social.email}
        </a>

        {
          socialLinks.length > 0 && (
            <ul class="flex gap-2">
              {socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-label={link.name}
                    class="inline-flex size-11 items-center justify-center border border-white/20 text-white/80 transition-colors hover:border-white hover:text-white"
                  >
                    <Icon name={link.icon} class="size-5" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }

        <LanguageSwitch
          lang={lang}
          switchLabel={header.switchLanguage}
          tone="dark"
          class="-mx-1.5"
        />
      </div>
    </div>

    <!-- Row 3: privacy note (the forms collect personal data) -->
    {
      footer.privacy && (
        <p class="mt-6 max-w-3xl text-xs text-white/60">{footer.privacy}</p>
      )
    }
  </div>
</footer>
