---
import type { Language } from "../content/site-config";
import { siteConfig } from "../content/site-config";
import type { SiteContent } from "../content/site-content";
import { socialLinks } from "../content/social-links";
import SiteLogo from "./SiteLogo.astro";
import Icon from "./Icon.astro";

interface Props {
  lang: Language;
  footer: SiteContent["footer"];
  navigation: SiteContent["navigation"];
}

const { lang, footer, navigation } = Astro.props;
const year = new Date().getFullYear();

// Same links and order as the header
const navItems = [
  { label: navigation.home, href: "#top" },
  { label: navigation.program, href: "#program" },
  { label: navigation.curriculum, href: "#curriculum" },
  { label: navigation.projects, href: "#projects" },
  { label: navigation.about, href: "#about" },
];
---

<footer class="bg-ink text-white">
  <div class="container-page py-12 md:py-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-12">
      <!-- Brand -->
      <div>
        <SiteLogo lang={lang} inverted class="mb-4" />
        <p class="max-w-xs text-sm text-white/70">{footer.tagline}</p>
      </div>

      <!-- Navigation -->
      <nav aria-label={footer.navigation}>
        <h3
          class="mb-3 font-heading text-sm font-semibold uppercase tracking-wider text-white/50"
        >
          {footer.navigation}
        </h3>
        <ul>
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="inline-flex min-h-11 items-center text-sm text-white/80 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h3
          class="mb-3 font-heading text-sm font-semibold uppercase tracking-wider text-white/50"
        >
          {footer.contact}
        </h3>
        <a
          href={`mailto:${siteConfig.social.email}`}
          class="inline-flex min-h-11 items-center text-sm text-white/80 transition-colors hover:text-white"
        >
          {siteConfig.social.email}
        </a>

        {
          socialLinks.length > 0 && (
            <ul class="mt-2 flex gap-2">
              {socialLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-label={link.name}
                    class="inline-flex size-11 items-center justify-center border border-white/20 text-white/80 transition-colors hover:border-white hover:text-white"
                  >
                    <Icon name={link.icon} class="size-5" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8">
      <p class="text-sm text-white/50">
        © {year} Hard Skills Lab. {footer.rights}
      </p>
    </div>
  </div>
</footer>
