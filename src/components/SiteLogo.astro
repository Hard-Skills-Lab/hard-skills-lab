---
import type { Language } from "../content/site-config";

interface Props {
  lang: Language;
  /** Use on dark backgrounds (white wordmark). */
  inverted?: boolean;
  class?: string;
}

const { lang, inverted = false, class: className } = Astro.props;
---

<a
  href={`/${lang}/`}
  class:list={[
    "inline-flex items-center gap-2.5",
    inverted ? "text-white" : "text-ink",
    className,
  ]}
>
  <!-- Placeholder mark: replace with the real logo SVG when available -->
  <svg
    class="size-7 shrink-0"
    viewBox="0 0 28 28"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <rect width="28" height="28" class="fill-orange"></rect>
    <rect x="7" y="7" width="14" height="3" class="fill-paper"></rect>
    <rect x="7" y="12.5" width="9" height="3" class="fill-paper"></rect>
    <rect x="7" y="18" width="14" height="3" class="fill-paper"></rect>
  </svg>
  <span
    class="font-heading text-xs font-semibold uppercase tracking-[0.06em] min-[400px]:text-sm sm:text-lg"
  >
    Hard Skills Lab
  </span>
</a>
