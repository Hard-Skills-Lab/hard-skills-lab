---
import type { Language } from "../content/site-config";

interface Props {
  lang: Language;
  /** Use on dark backgrounds (white wordmark). */
  inverted?: boolean;
  class?: string;
}

const { lang, inverted = false, class: className } = Astro.props;
---

<a
  href={`/${lang}/`}
  class:list={[
    "inline-flex items-center gap-2.5",
    inverted ? "text-white" : "text-ink",
    className,
  ]}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 28 28"
    width="28"
    height="28"
    aria-hidden="true"
  >
    <!-- <style>
      .fill-orange {
        fill: #d94f2b;
      }
      .fill-paper {
        fill: #ffffff;
      }
    </style> -->
    <rect width="28" height="28" class="fill-orange"></rect>
    <rect x="7" y="7" width="3" height="14" class="fill-paper"></rect>
    <rect x="12.5" y="11.666" width="3" height="4.667" class="fill-paper"
    ></rect>
    <rect x="18" y="7" width="3" height="14" class="fill-paper"></rect>
  </svg>
  <span
    class="font-heading text-xs font-semibold uppercase tracking-[0.06em] min-[400px]:text-sm sm:text-lg"
  >
    Hard Skills Lab
  </span>
</a>
