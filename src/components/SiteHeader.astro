---
import type { Language } from "../content/site-config";
import { getContent, getMainCta } from "../content/site-content";
import type { SiteContent } from "../content/site-content";
import SiteLogo from "./SiteLogo.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import PrimaryButton from "./PrimaryButton.astro";
import Icon from "./Icon.astro";
import { socialLinks } from "../content/social-links";

interface Props {
  lang: Language;
  navigation: SiteContent["navigation"];
}

const { lang, navigation } = Astro.props;
const { header } = getContent(lang);
const cta = getMainCta(lang);

// Order follows the order of the sections on the page.
// "#top" scrolls to the top of the page (Home).
const navItems = [
  { label: navigation.home, href: "#top" },
  { label: navigation.program, href: "#program" },
  { label: navigation.curriculum, href: "#curriculum" },
  { label: navigation.projects, href: "#projects" },
  { label: navigation.about, href: "#about" },
  { label: navigation.faq, href: "#faq" },
];
---

<header class="sticky top-0 z-50 border-b border-rule/70 bg-paper">
  <div
    class="container-page flex h-14 items-center justify-between gap-3 sm:h-16 lg:gap-6"
  >
    <SiteLogo lang={lang} />

    <!-- Desktop navigation -->
    <nav
      class="hidden items-center gap-6 lg:flex xl:gap-8"
      aria-label={header.mainNavLabel}
    >
      {
        navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            class="border-b-2 border-transparent py-2 text-sm font-medium text-ink transition-colors hover:border-rule aria-[current=location]:border-orange"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-1 lg:gap-4">
      <LanguageSwitch lang={lang} switchLabel={header.switchLanguage} />

      <div class="hidden lg:block">
        <PrimaryButton href={cta.href} size="sm" arrow>
          {cta.label}
        </PrimaryButton>
      </div>

      <!-- Mobile menu button -->
      <button
        type="button"
        id="menu-open"
        class="-mr-2 inline-flex size-11 items-center justify-center text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={header.openMenu}
      >
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu (full screen) -->
  <div
    id="mobile-menu"
    class="fixed inset-0 z-50 hidden flex-col overflow-y-auto bg-ink text-white lg:hidden"
    role="dialog"
    aria-modal="true"
    aria-label={header.menuLabel}
  >
    <div
      class="container-page flex h-14 shrink-0 items-center justify-between sm:h-16"
    >
      <SiteLogo lang={lang} inverted />
      <button
        type="button"
        id="menu-close"
        class="-mr-2 inline-flex size-11 items-center justify-center text-white"
        aria-label={header.closeMenu}
      >
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18"></path>
        </svg>
      </button>
    </div>

    <div class="container-page flex flex-1 flex-col pb-8 pt-10">
      <nav aria-label={header.mainNavLabel}>
        <ul class="flex flex-col items-start gap-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  data-nav-link
                  class="inline-block border-b-2 border-transparent py-1 font-heading text-2xl font-medium text-white aria-[current=location]:border-orange"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <LanguageSwitch
        lang={lang}
        switchLabel={header.switchLanguage}
        tone="dark"
        class="-ml-1.5 mt-8"
      />

      <PrimaryButton href={cta.href} arrow class="mt-6 w-full">
        {cta.label}
      </PrimaryButton>

      {
        socialLinks.length > 0 && (
          <ul class="mt-8 flex flex-col gap-1">
            {socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="inline-flex min-h-11 items-center gap-3 text-sm font-medium text-white/80 transition-colors hover:text-white"
                >
                  <Icon name={link.icon} class="size-5" />
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <p class="mt-auto border-t border-white/15 pt-6 text-sm text-white/70">
        {header.tagline}
      </p>
    </div>
  </div>
</header>

<script>
  // Must match Tailwind's `lg` breakpoint (1024px)
  const DESKTOP_QUERY = "(min-width: 1024px)";

  const initMobileMenu = () => {
    const openButton = document.getElementById(
      "menu-open",
    ) as HTMLButtonElement | null;
    const closeButton = document.getElementById(
      "menu-close",
    ) as HTMLButtonElement | null;
    const menu = document.getElementById("mobile-menu");

    if (!openButton || !closeButton || !menu) return;

    let isOpen = false;
    let previousOverflow = "";

    const getFocusable = () =>
      Array.from(
        menu.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
      );

    const openMenu = () => {
      if (isOpen) return;
      isOpen = true;
      previousOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      menu.classList.remove("hidden");
      menu.classList.add("flex");
      openButton.setAttribute("aria-expanded", "true");
      closeButton.focus();
    };

    const closeMenu = (restoreFocus = true) => {
      if (!isOpen) return;
      isOpen = false;
      document.body.style.overflow = previousOverflow;
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      openButton.setAttribute("aria-expanded", "false");
      if (restoreFocus) openButton.focus();
    };

    openButton.addEventListener("click", openMenu);
    closeButton.addEventListener("click", () => closeMenu());

    // Close after choosing a section
    menu.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((link) => {
      link.addEventListener("click", () => closeMenu(false));
    });

    document.addEventListener("keydown", (event) => {
      if (!isOpen) return;

      if (event.key === "Escape") {
        event.preventDefault();
        closeMenu();
        return;
      }

      // Keep keyboard focus inside the open menu
      if (event.key === "Tab") {
        const focusable = getFocusable();
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    // Close if the viewport becomes desktop-sized while the menu is open
    window.matchMedia(DESKTOP_QUERY).addEventListener("change", (event) => {
      if (event.matches) closeMenu(false);
    });
  };

  // Marks the nav link of the section currently under the header
  const initScrollSpy = () => {
    const links = Array.from(
      document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
    );
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("main section[id]"),
    );
    if (links.length === 0) return;

    const OFFSET = 120; // a bit more than the sticky header height

    const update = () => {
      let activeId = "top";
      let closest = -Infinity;

      for (const section of sections) {
        const top = section.getBoundingClientRect().top;
        if (top <= OFFSET && top > closest) {
          closest = top;
          activeId = section.id;
        }
      }

      for (const link of links) {
        if (link.getAttribute("href") === `#${activeId}`) {
          link.setAttribute("aria-current", "location");
        } else {
          link.removeAttribute("aria-current");
        }
      }
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  };

  initMobileMenu();
  initScrollSpy();
</script>
