---
import type { Language } from "../content/site-config";

interface Props {
  lang: Language;
  /** Accessible name of the link that goes to the other language. */
  switchLabel: string;
  tone?: "light" | "dark";
  class?: string;
}

const { lang, switchLabel, tone = "light", class: className } = Astro.props;
const dark = tone === "dark";

const items: Array<{ code: Language; label: string }> = [
  { code: "fr", label: "FR" },
  { code: "en", label: "EN" },
];
---

<div class:list={["flex items-center text-sm", className]}>
  {
    items.map((item, index) => (
      <>
        {index > 0 && (
          <span
            class:list={["select-none", dark ? "text-white/40" : "text-rule"]}
            aria-hidden="true"
          >
            /
          </span>
        )}
        {item.code === lang ? (
          <span
            class:list={[
              "inline-flex min-h-11 items-center px-1.5 font-bold",
              dark ? "text-white" : "text-ink",
            ]}
            aria-current="true"
          >
            {item.label}
          </span>
        ) : (
          <a
            href={`/${item.code}/`}
            hreflang={item.code}
            lang={item.code}
            aria-label={switchLabel}
            class:list={[
              "inline-flex min-h-11 items-center px-1.5 font-medium transition-colors",
              dark
                ? "text-white/70 hover:text-white"
                : "text-muted hover:text-ink",
            ]}
          >
            {item.label}
          </a>
        )}
      </>
    ))
  }
</div>
