---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  size?: "sm" | "md";
  /** Adds a trailing arrow that nudges right on hover/focus */
  arrow?: boolean;
  /** Read by screen readers after the label when the link opens in a new tab */
  srLabel?: string;
  class?: string;
}

const {
  href,
  variant = "primary",
  size = "md",
  arrow = false,
  srLabel,
  class: className,
} = Astro.props;

// Links to other sites (like the application form) open in a new tab,
// so the visitor keeps the website open behind it
const external = /^https?:\/\//.test(href);

const base =
  "group inline-flex items-center justify-center gap-2 font-semibold transition-colors";

const sizes = {
  sm: "min-h-11 px-4 text-sm",
  md: "min-h-12 px-6 text-base",
};

const variants = {
  // Darker orange so the white label passes WCAG AA (5.6:1)
  primary: "bg-orange-deep text-white hover:brightness-90",
  secondary: "border border-ink text-ink hover:bg-ink hover:text-white",
};
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[base, sizes[size], variants[variant], className]}
>
  <slot />
  {external && srLabel && <span class="sr-only">&nbsp;{srLabel}</span>}
  {
    arrow && (
      <svg
        class="size-4 transition-transform group-hover:translate-x-0.5 group-focus-visible:translate-x-0.5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    )
  }
</a>
