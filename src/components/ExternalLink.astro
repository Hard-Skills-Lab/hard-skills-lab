---
import Icon from "./Icon.astro";

interface Props {
  href: string;
  /** Read by screen readers after the label, e.g. "(opens in a new tab)". Only used when external. */
  srLabel?: string;
  /** External links open in a new tab. Set to false for mailto: or same-site links. */
  external?: boolean;
  class?: string;
}

const { href, srLabel, external = true, class: className } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class:list={[
    "group inline-flex min-h-11 items-center text-sm font-semibold text-ink transition-colors hover:text-orange-deep",
    className,
  ]}
>
  <span
    class="inline-flex items-center gap-1.5 border-b-2 border-orange pb-0.5"
  >
    <slot />
    <Icon
      name={external ? "arrowUpRight" : "arrowRight"}
      class={external
        ? "size-4 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
        : "size-4 transition-transform group-hover:translate-x-0.5"}
    />
  </span>
  {external && srLabel && <span class="sr-only">&nbsp;{srLabel}</span>}
</a>
