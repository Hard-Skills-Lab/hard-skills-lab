---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitch from "../../components/LanguageSwitch.astro";
import { getContent } from "../../content/site-content";
import { siteConfig } from "../../content/site-config";

const lang = "en" as const;
const t = getContent(lang);
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <main class="min-h-screen px-4 py-16">
    <div class="absolute top-4 right-4">
      <LanguageSwitch currentLang={lang} />
    </div>
    <div class="max-w-4xl mx-auto text-center">
      <!-- rest of content stays the same -->
      <p class="text-sm font-mono text-orange mb-4">{t.hero.badge}</p>
      <h1 class="text-4xl md:text-5xl font-bold mb-6">
        {t.hero.title}
      </h1>
      <p class="text-lg text-muted mb-8 max-w-2xl mx-auto">
        {t.hero.subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href={siteConfig.applicationUrls.en}
          class="inline-flex items-center justify-center px-6 py-3 bg-orange text-white font-medium hover:bg-orange/90 transition-colors"
        >
          {t.hero.primaryCta}
        </a>
        <a
          href="#program"
          class="inline-flex items-center justify-center px-6 py-3 border border-ink text-ink font-medium hover:bg-ink hover:text-white transition-colors"
        >
          {t.hero.secondaryCta}
        </a>
      </div>
    </div>
  </main>
</BaseLayout>
