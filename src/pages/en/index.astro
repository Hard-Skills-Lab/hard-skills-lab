---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import PrimaryButton from "../../components/PrimaryButton.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ImagePlaceholder from "../../components/ImagePlaceholder.astro";
import Icon from "../../components/Icon.astro";
import { getContent } from "../../content/site-content";
import { siteConfig } from "../../content/site-config";

const lang = "en" as const;
const t = getContent(lang);
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <SiteHeader lang={lang} navigation={t.navigation} />

  <main>
    <!--
      Hero. A <div> on purpose (not a <section>): the temporary global
      `section { padding }` rule would override its spacing. Revisit in 1.4.h.
    -->
    <div id="top" class="relative scroll-mt-20 overflow-hidden">
      <!-- Text -->
      <div class="container-page">
        <div
          class="relative z-10 flex flex-col justify-center pb-10 pt-10 sm:pt-14 lg:min-h-[34rem] lg:w-[55%] lg:py-20"
        >
          <p class="eyebrow">{t.hero.eyebrow}</p>
          <h1
            class="mt-5 font-heading text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl xl:text-6xl"
          >
            {t.hero.titleLines.map((line) => <span class="block">{line}</span>)}
          </h1>
          <p class="mt-6 max-w-md text-base text-ink/80 sm:text-lg">
            {t.hero.subtitle}
          </p>
          <div class="mt-8">
            <PrimaryButton href={siteConfig.applicationUrls[lang]} arrow>
              {t.hero.cta}
            </PrimaryButton>
          </div>
        </div>
      </div>

      <!-- Visual: below the text on mobile, anchored to the right on desktop -->
      <div
        class="px-4 pb-8 sm:px-6 lg:absolute lg:inset-y-0 lg:right-0 lg:w-[50%] lg:p-0 2xl:w-[45%]"
      >
        <div
          class="relative aspect-[4/5] sm:aspect-[16/10] lg:aspect-auto lg:h-full"
        >
          <ImagePlaceholder
            label="Hero portrait"
            class="absolute inset-0 lg:right-[9%]"
          />

          <!-- Orange block (desktop only) -->
          <div
            class="absolute right-0 top-[37%] hidden h-[15.5%] w-[9%] bg-orange lg:block"
            aria-hidden="true"
          >
          </div>

          <!-- Landscape thumbnail (desktop only) -->
          <div
            class="absolute bottom-0 right-0 hidden h-[47%] w-[14.5%] lg:block"
          >
            <ImagePlaceholder label="Landscape" tone="dark" class="h-full" />
          </div>

          <!-- Learn / Build / Grow (desktop only, decorative) -->
          <ul
            class="absolute right-[calc(9%_+_2rem)] top-[17%] hidden border-l-2 border-orange pl-3 text-xs font-medium uppercase leading-5 tracking-[0.18em] text-ink lg:block"
            aria-hidden="true"
          >
            {t.hero.pillars.map((pillar) => <li>{pillar}</li>)}
          </ul>
        </div>
      </div>

      <!-- Scroll cue (mobile / tablet) -->
      <div class="container-page pb-6 lg:hidden">
        <a
          href="#program"
          class="inline-flex min-h-11 flex-col items-start justify-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-muted"
        >
          {t.hero.scroll}
          <svg
            class="size-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14M6 13l6 6 6-6"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Program Section (includes the mission card) -->
    <section id="program" class="section-y bg-paper-soft">
      <div class="container-page">
        <div class="grid gap-10 lg:grid-cols-12 lg:items-stretch lg:gap-12">
          <!-- Intro + facts -->
          <div class="lg:col-span-7">
            <p class="eyebrow">{t.program.eyebrow}</p>
            <h2 class="heading-section mt-4 max-w-xl">{t.program.title}</h2>
            <p class="mt-5 max-w-xl text-base text-muted sm:text-lg">
              {t.program.intro}
            </p>

            <ul
              class="mt-10 grid grid-cols-2 border-y border-rule md:grid-cols-4 md:border-y-0"
            >
              {
                t.program.facts.map((fact) => (
                  <li class="border-rule px-4 py-6 odd:pl-0 even:border-l [&:nth-child(n+3)]:border-t md:first:pl-0 md:[&:nth-child(n+2)]:border-l md:[&:nth-child(n+2)]:pl-4 md:[&:nth-child(n+3)]:border-t-0">
                    <Icon name={fact.icon} class="size-8 text-orange" />
                    <p class="mt-4 font-heading text-base font-semibold leading-snug">
                      {fact.title}
                    </p>
                    <p class="mt-1 text-sm text-muted">{fact.text}</p>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Mission card (desktop only) -->
          <div class="hidden lg:col-span-5 lg:block">
            <div class="grid h-full grid-cols-2 bg-rule/40">
              <div class="flex flex-col p-8">
                <p class="eyebrow">{t.program.mission.eyebrow}</p>
                <h3
                  class="mt-4 font-heading text-xl font-semibold leading-tight xl:text-2xl"
                >
                  {t.program.mission.title}
                </h3>
                <p class="mt-4 text-sm text-muted">{t.program.mission.text}</p>
                <div class="mt-auto pt-8">
                  <span class="block h-0.5 w-8 bg-orange" aria-hidden="true"
                  ></span>
                </div>
              </div>
              <ImagePlaceholder
                label="Landscape"
                tone="dark"
                class="min-h-[20rem]"
              />
            </div>
          </div>
        </div>

        <!-- Landscape + Learn › Build › Grow (mobile / tablet) -->
        <div class="relative mt-10 aspect-[16/10] sm:aspect-[2/1] lg:hidden">
          <ImagePlaceholder
            label="Landscape"
            tone="dark"
            labelPosition="top-right"
            class="absolute inset-0"
          />
          <p
            class="absolute bottom-3 left-4 text-[11px] font-semibold uppercase tracking-[0.18em] text-white"
            aria-hidden="true"
          >
            {t.hero.pillars.join("  ›  ")}
          </p>
        </div>
      </div>
    </section>

    <!-- Curriculum Section -->
    <section id="curriculum" class="section-y">
      <div class="container-page">
        <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
          <!-- Intro -->
          <div class="lg:col-span-4 xl:col-span-5">
            <p class="eyebrow">{t.curriculum.eyebrow}</p>
            <h2 class="heading-section mt-4 max-w-md">
              {t.curriculum.title[0]}
              <br />
              {t.curriculum.title[1]}
            </h2>
            <p class="mt-5 max-w-md text-base text-muted sm:text-lg">
              {t.curriculum.intro}
            </p>
          </div>

          <!-- Mobile / tablet: one list, data + AI topic per week.
               Assumes tracks[0] = data and tracks[1] = AI. -->
          <ol class="border-t border-rule lg:hidden">
            {
              t.curriculum.tracks[0].weeks.map((dataWeek, index) => (
                <li class="flex gap-4 border-b border-rule py-5">
                  <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-orange text-[11px] font-semibold text-white">
                    {index + 1}
                  </span>
                  <div>
                    <p class="text-xs text-muted">
                      {t.curriculum.weekLabel} {index + 1}
                    </p>
                    <p class="mt-1 text-sm font-medium">{dataWeek}</p>
                    <p class="my-0.5 text-xs text-muted" aria-hidden="true">
                      +
                    </p>
                    <p class="text-sm text-muted">
                      {t.curriculum.tracks[1].weeks[index]}
                    </p>
                  </div>
                </li>
              ))
            }
          </ol>

          <!-- Desktop: one column per track -->
          <div
            class="hidden gap-8 lg:col-span-8 lg:grid lg:grid-cols-2 xl:col-span-7 xl:gap-12"
          >
            {
              t.curriculum.tracks.map((track) => (
                <div>
                  <h3 class="flex flex-wrap items-baseline gap-x-2 font-heading text-lg font-semibold leading-snug">
                    {track.shortTitle}
                    {/* <span class="text-xs font-normal text-muted">
                      ({track.lead})
                    </span> */}
                  </h3>
                  <ol class="relative mt-4 before:absolute before:bottom-6 before:left-[11.5px] before:top-6 before:w-px before:bg-orange/40">
                    {track.weeks.map((week, index) => (
                      <li class="relative flex items-center gap-3 border-b border-rule py-3 text-sm">
                        <span class="relative z-10 flex size-6 shrink-0 items-center justify-center rounded-full bg-orange text-[11px] font-semibold text-white">
                          {index + 1}
                        </span>
                        <span>{week}</span>
                      </li>
                    ))}
                  </ol>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!--
      Tracks (mobile / tablet only: on desktop the tracks are the two columns
      above). No id on purpose: it is display:none on desktop and would
      confuse the header's scroll-spy.
    -->
    <section class="section-y bg-paper-soft lg:hidden">
      <div class="container-page">
        <p class="eyebrow">{t.curriculum.tracksSection.eyebrow}</p>
        <h2 class="heading-section mt-4">{t.curriculum.tracksSection.title}</h2>
        <p class="mt-5 max-w-xl text-base text-muted sm:text-lg">
          {t.curriculum.tracksSection.intro}
        </p>

        <ol class="mt-8 grid gap-4 sm:grid-cols-2">
          {
            t.curriculum.tracks.map((track, index) => (
              <li class="bg-rule/40 p-6">
                <span
                  class="font-heading text-3xl font-normal text-orange"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, "0")}
                </span>
                <h3 class="mt-3 font-heading text-xl font-semibold leading-tight">
                  {track.title}
                </h3>
                <p class="mt-3 text-sm text-muted">{track.summary}</p>
              </li>
            ))
          }
        </ol>

        <ImagePlaceholder
          label="Code screenshot"
          tone="dark"
          labelPosition="top-right"
          class="mt-6 aspect-[16/9] sm:aspect-[2/1]"
        />
      </div>
    </section>

    <!-- About Section -->
    <section
      id="about"
      class="px-4 sm:px-6 lg:px-8 bg-white border-y border-rule"
    >
      <div class="max-w-7xl mx-auto">
        <SectionHeading title={t.about.title} />
        <div class="grid md:grid-cols-2 gap-8 mb-12">
          <div>
            <h3 class="text-lg font-heading font-semibold mb-3">Mission</h3>
            <p class="text-muted">{t.about.mission}</p>
          </div>
          <div>
            <h3 class="text-lg font-heading font-semibold mb-3">Vision</h3>
            <p class="text-muted">{t.about.vision}</p>
          </div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {
            t.about.founders.map((founder) => (
              <article class="border border-rule p-6">
                <div class="w-16 h-16 bg-rule mb-4" aria-hidden="true" />
                <h3 class="font-heading font-semibold">{founder.name}</h3>
                <p class="text-sm text-orange mb-2">{founder.role}</p>
                <p class="text-sm text-muted">{founder.bio}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section id="faq" class="px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto">
        <SectionHeading title={t.faq.title} />
        <div class="space-y-6">
          {
            t.faq.questions.map((item) => (
              <details class="border border-rule bg-white group">
                <summary class="p-6 cursor-pointer font-medium hover:text-orange transition-colors list-none flex justify-between items-center">
                  {item.question}
                  <svg
                    class="w-5 h-5 text-muted group-open:rotate-180 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </summary>
                <div class="px-6 pb-6 text-muted">{item.answer}</div>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Apply Section -->
    <section id="apply" class="px-4 sm:px-6 lg:px-8 bg-ink text-white">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">
          {t.apply.title}
        </h2>
        <p class="text-lg text-white/70 mb-8 max-w-2xl mx-auto">
          {t.apply.description}
        </p>
        <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-8 text-left">
          {
            t.apply.requirements.map((req) => (
              <div class="border border-white/20 p-4 text-sm text-white/80">
                {req}
              </div>
            ))
          }
        </div>
        <PrimaryButton
          href={siteConfig.applicationUrls.en}
          class="text-lg px-8 py-4"
        >
          {t.apply.cta}
        </PrimaryButton>
      </div>
    </section>
  </main>

  <SiteFooter lang={lang} footer={t.footer} navigation={t.navigation} />
</BaseLayout>
